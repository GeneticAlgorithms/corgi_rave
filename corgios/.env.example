# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# --- Claude (the corgi's brain) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (voice) ---
# TTS + Scribe STT both work on the FREE tier (10,000 chars/month).
ELEVENLABS_API_KEY=
# Default is "Roger". List options: curl -H "xi-api-key: $KEY" https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_TTS_MODEL=eleven_v3

# --- Music ---
# "library"    plays mp3s from public/tracks/library/ — works on any tier. DEFAULT.
# "elevenlabs" calls /v1/music/compose — REQUIRES A PAID PLAN (free returns HTTP 402
#              paid_plan_required). Falls back to the library automatically on failure.
MUSIC_BACKEND=library

# --- Day signal ---
# false = read fixtures/day.md (deterministic, always works).
# true  = pull live via the merge CLI, falling back to the fixture on any error.
#         First link a connector:  merge execute-tool authenticate_outlook '{}'
USE_LIVE_MERGE=false
MERGE_BIN=/Users/corgioffice/Library/Application Support/pipx/venvs/merge-api/bin/merge
MERGE_TIMEZONE=America/Los_Angeles

# --- Safety net ---
# Phone number or email of the friend to text. space.create() opens the chat, so
# they do NOT need to have messaged the corgi first.
BUDDY_HANDLE=
BUDDY_NAME=Sam
DISTRESS_COUNTDOWN_MS=20000

# --- Serving ---
PORT=3001
# MUST be reachable from the phone — localhost will not resolve on device.
# Use your LAN IP (ipconfig getifaddr en0) or a tunnel.
PUBLIC_BASE_URL=http://localhost:3001
# Where the visualizer (repo root) is served from.
FRONTEND_ORIGIN=http://localhost:8000
